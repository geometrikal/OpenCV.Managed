<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Override to hash a known-good build, e.g. a git worktree of an earlier commit. -->
    <OpenCvProject Condition="'$(OpenCvProject)' == ''">..\..\..\Geometrikal.OpenCV.Managed\Geometrikal.OpenCV.Managed.csproj</OpenCvProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(OpenCvProject)" />
    <Compile Include="..\..\Regression\RegressionCases.cs" Link="RegressionCases.cs" />
  </ItemGroup>

</Project>
